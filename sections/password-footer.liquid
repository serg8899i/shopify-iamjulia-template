{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div
  class="password-footer color-custom-{{ section.id }}{% if section.settings.overlay %} password-footer--overlay{% endif %}"
  data-testid="password-footer"
>
  {%- if section.settings.show_powered_by -%}
  <p class="password-footer__powered-by">
    {{ 'content.powered_by' | t }}
    <a
      href="//shopify.com"
      rel="nofollow"
      target="_blank"
      aria-label="Shopify"
      aria-describedby="a11y-new-window-message"
    >
      {{- 'icon-shopify.svg' | inline_asset_content -}}
    </a>
  </p>
  {%- endif -%}
  <div class="password-footer__links">
    <button
      class="button-unstyled password-footer__button"
      on:click="#password-form/showDialog"
    >
      {%- if section.settings.overlay and section.settings.password_label != blank -%}
        {{ section.settings.password_label | escape }}
      {%- else -%}
        {{ 'actions.enter_using_password' | t }}
      {%- endif -%}
    </button>
    <p class="password-footer__admin-link">
      {%- if section.settings.overlay and section.settings.login_label != blank -%}
        <a href="/admin">{{ section.settings.login_label | escape }}</a>
      {%- else -%}
        {{ 'content.store_owner_link_html' | t: link: '/admin' }}
      {%- endif -%}
    </p>
  </div>
  <ul hidden>
    <li id="a11y-new-window-message">{{ 'accessibility.new_window' | t }}</li>
  </ul>
</div>

{% stylesheet %}
  .password-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-sm);
    padding-block: var(--padding-xl);
  }

  .password-footer__powered-by {
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--padding-xs);
    height: 1em;

    > a {
      display: flex;
    }

    .icon-shopify {
      display: inline;
      height: 1.3em;
      color: var(--color-foreground);
    }
  }

  .password-footer__links {
    display: flex;
    align-items: center;
    gap: var(--gap-2xl);

    @media screen and (max-width: 749px) {
      flex-direction: column;
      gap: var(--gap-sm);
    }
  }

  .password-footer__admin-link {
    margin: 0;
  }

  .password-footer__button {
    height: var(--minimum-touch-target);
    background-color: transparent;
    color: var(--color-foreground);
    cursor: pointer;
    text-decoration: underline;

    &:hover {
      color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
      text-decoration: none;
    }
  }
  body:has(.password-footer--overlay) .password-main-content .section-password .section {
    min-height: 100svh;
  }

  footer:has(.password-footer--overlay) {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 2;
  }

  .password-footer--overlay {
    background: linear-gradient(to top, rgb(0 0 0 / 0.45), rgb(0 0 0 / 0));
    padding-block-start: var(--padding-4xl, 48px);
    color: #fff;
    text-shadow: 0 1px 4px rgb(0 0 0 / 0.55);
    padding-block: var(--padding-lg);

    .password-footer__links {
      flex-direction: row;
      gap: var(--gap-2xl);
    }

    .password-footer__button,
    .password-footer__admin-link a {
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .password-footer__button:hover,
    .password-footer__admin-link a:hover {
      color: inherit;
      text-decoration: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.footer_password",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "Show \"powered by Shopify\"",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "overlay",
      "label": "Show links over the page background",
      "default": true
    },
    {
      "type": "text",
      "id": "password_label",
      "label": "Password link label",
      "default": "Enter password"
    },
    {
      "type": "text",
      "id": "login_label",
      "label": "Owner login link label",
      "default": "Log in"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    }
  ]
}
{% endschema %}
