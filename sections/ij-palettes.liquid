<div class="section section--page-width ij-palettes">
  <div class="ij-palettes__header">
    {%- if section.settings.heading != blank -%}
      <h2 class="ij-palettes__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="ij-palettes__text">{{ section.settings.text }}</div>
    {%- endif -%}
  </div>

  <div class="ij-palettes__grid">
    {%- for block in section.blocks -%}
      {%- capture tag -%}{% if block.settings.link != blank %}a{% else %}div{% endif %}{%- endcapture -%}
      <{{ tag }}
        class="ij-palettes__card"
        {% if block.settings.link != blank %}
          href="{{ block.settings.link }}"
        {% endif %}
        {{ block.shopify_attributes }}
      >
        <div class="ij-palettes__media">
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1000
              | image_tag:
                class: 'ij-palettes__image',
                sizes: '(min-width: 750px) 33vw, 100vw',
                loading: 'lazy'
            }}
          {%- else -%}
            <div
              class="ij-palettes__image ij-palettes__image--placeholder"
              style="background: linear-gradient(135deg, {{ block.settings.color_1 }}, {{ block.settings.color_2 }}, {{ block.settings.color_3 }});"
            ></div>
          {%- endif -%}
        </div>
        <div class="ij-palettes__body">
          <div class="ij-palettes__swatches" aria-hidden="true">
            <span style="background: {{ block.settings.color_1 }};"></span>
            <span style="background: {{ block.settings.color_2 }};"></span>
            <span style="background: {{ block.settings.color_3 }};"></span>
          </div>
          <h3 class="ij-palettes__name">{{ block.settings.name | escape }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="ij-palettes__desc">{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </div>
      </{{ tag }}>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .ij-palettes {
    padding-block: clamp(40px, 7vw, 96px);
  }

  .ij-palettes__header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto clamp(24px, 4vw, 48px);
  }

  .ij-palettes__heading {
    margin: 0 0 10px;
    font-family: var(--font-heading--family);
    font-size: clamp(1.8rem, 3.5vw, 2.75rem);
    line-height: 1.1;
  }

  .ij-palettes__text p {
    margin: 0;
  }

  .ij-palettes__grid {
    display: grid;
    gap: 20px;
  }

  @media screen and (min-width: 750px) {
    .ij-palettes__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .ij-palettes__card {
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / 0.04);
    color: inherit;
    text-decoration: none;
  }

  .ij-palettes__image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .ij-palettes__media {
    overflow: hidden;
  }

  a.ij-palettes__card:hover .ij-palettes__image {
    transform: scale(1.03);
  }

  @media (prefers-reduced-motion: reduce) {
    .ij-palettes__image {
      transition: none;
    }

    a.ij-palettes__card:hover .ij-palettes__image {
      transform: none;
    }
  }

  .ij-palettes__body {
    padding: 18px 20px 22px;
  }

  .ij-palettes__swatches {
    display: flex;
    gap: 6px;
    margin-bottom: 10px;
  }

  .ij-palettes__swatches span {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid var(--color-background);
    box-shadow: 0 0 0 1px rgb(var(--color-foreground-rgb) / 0.12);
  }

  .ij-palettes__name {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.35rem;
  }

  .ij-palettes__desc {
    margin: 6px 0 0;
    opacity: 0.8;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Palettes",
  "tag": "section",
  "class": "ij-palettes-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pick a palette"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Every piece in a palette is designed to go together — from the banner to the toppers.</p>"
    }
  ],
  "blocks": [
    {
      "type": "palette",
      "name": "Palette",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Palette"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "color",
          "id": "color_1",
          "label": "Swatch 1",
          "default": "#f6c7d4"
        },
        {
          "type": "color",
          "id": "color_2",
          "label": "Swatch 2",
          "default": "#fbe7a6"
        },
        {
          "type": "color",
          "id": "color_3",
          "label": "Swatch 3",
          "default": "#bfe3d4"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Palettes",
      "blocks": [
        {
          "type": "palette",
          "settings": {
            "name": "Blue",
            "text": "Navy, red, mustard and sage with stars and clouds.",
            "color_1": "#3f5f9e",
            "color_2": "#d9473f",
            "color_3": "#e3b23c"
          }
        },
        {
          "type": "palette",
          "settings": {
            "name": "Pastel",
            "text": "Soft rainbow pastels with flowers, clouds and hearts.",
            "color_1": "#d9c6f0",
            "color_2": "#fbe7a6",
            "color_3": "#bfe3d4"
          }
        },
        {
          "type": "palette",
          "settings": {
            "name": "Pink",
            "text": "Soft pinks with white letters and little rainbows.",
            "color_1": "#f2bccb",
            "color_2": "#fbe3e8",
            "color_3": "#f1d3b6"
          }
        }
      ]
    }
  ]
}
{% endschema %}
