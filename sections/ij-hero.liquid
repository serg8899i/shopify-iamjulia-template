{%- liquid
  assign image = section.settings.image
  assign height_class = 'ij-hero--' | append: section.settings.height
  assign layout_class = 'ij-hero--' | append: section.settings.layout
-%}

<div class="section {% if section.settings.layout == 'fullscreen' %}section--full-width{% else %}section--page-width{% endif %} ij-hero {{ height_class }} {{ layout_class }}{% if image == blank %} ij-hero--no-image{% endif %}">
  <div class="ij-hero__inner">
    <div class="ij-hero__media">
      {%- if image != blank -%}
        {{
          image
          | image_url: width: 2400
          | image_tag:
            class: 'ij-hero__image',
            sizes: '100vw',
            widths: '750, 1100, 1500, 1800, 2400',
            loading: 'eager',
            fetchpriority: 'high',
            style: section.settings.image_position
        }}
      {%- else -%}
        <div class="ij-hero__placeholder" aria-hidden="true">
          <span class="ij-hero__shape ij-hero__shape--1"></span>
          <span class="ij-hero__shape ij-hero__shape--2"></span>
          <span class="ij-hero__shape ij-hero__shape--3"></span>
        </div>
      {%- endif -%}
    </div>

    <div class="ij-hero__content" style="--ij-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ij-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="ij-hero__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="ij-hero__text">{{ section.settings.text }}</div>
      {%- endif -%}
      <div class="ij-hero__buttons">
        {%- if section.settings.button_label != blank -%}
          <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank and section.settings.button2_link != blank -%}
          <a class="button button-secondary" href="{{ section.settings.button2_link }}">
            {{- section.settings.button2_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .ij-hero__inner {
    position: relative;
    display: grid;
    border-radius: var(--ij-radius, 20px);
    overflow: hidden;
    margin-block: 16px;
  }

  .ij-hero__media,
  .ij-hero__content {
    grid-area: 1 / 1;
  }

  .ij-hero--medium .ij-hero__inner {
    min-height: min(70vh, 640px);
  }

  .ij-hero--large .ij-hero__inner {
    min-height: min(88vh, 820px);
  }

  .ij-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ij-hero__placeholder {
    position: relative;
    height: 100%;
    background: linear-gradient(135deg, #f8dfe6 0%, #fbf0d7 35%, #dcefe6 70%, #dbe6f6 100%);
  }

  .ij-hero__shape {
    position: absolute;
    border-radius: 50%;
    opacity: 0.55;
  }

  .ij-hero__shape--1 {
    width: 38%;
    aspect-ratio: 1;
    background: #e9d5f3;
    top: -10%;
    right: 8%;
  }

  .ij-hero__shape--2 {
    width: 22%;
    aspect-ratio: 1;
    background: #fde9a8;
    bottom: -6%;
    right: 30%;
  }

  .ij-hero__shape--3 {
    width: 16%;
    aspect-ratio: 1;
    background: #c9e7d8;
    top: 18%;
    left: 52%;
  }

  .ij-hero__content {
    align-self: end;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(24px, 5vw, 64px);
    max-width: 680px;
    color: #fff;
    z-index: 1;
  }

  .ij-hero:not(.ij-hero--no-image) .ij-hero__content {
    max-width: none;
    background: linear-gradient(to top, rgb(0 0 0 / var(--ij-overlay)) 0%, rgb(0 0 0 / 0) 100%);
  }

  .ij-hero:not(.ij-hero--no-image) .ij-hero__content > * {
    max-width: 640px;
  }

  .ij-hero--no-image .ij-hero__content {
    align-self: center;
    color: var(--color-foreground);
  }

  .ij-hero__eyebrow {
    margin: 0;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .ij-hero__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(2.2rem, 5.5vw, 4.25rem);
    line-height: 1.05;
    color: inherit;
  }

  .ij-hero__text {
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.5;
  }

  .ij-hero__text p {
    margin: 0;
  }

  /* Split layout: text beside the full, uncropped photo so no product part is covered. */
  .ij-hero--split .ij-hero__inner {
    min-height: 0;
    gap: clamp(20px, 4vw, 56px);
    align-items: center;
    overflow: visible;
    border-radius: 0;
  }

  .ij-hero--split .ij-hero__media,
  .ij-hero--split .ij-hero__content {
    grid-area: auto;
  }

  .ij-hero--split .ij-hero__media {
    border-radius: 20px;
    overflow: hidden;
  }

  .ij-hero--split .ij-hero__image {
    height: auto;
    aspect-ratio: auto;
  }

  .ij-hero--split .ij-hero__placeholder {
    aspect-ratio: 4 / 3;
    border-radius: 20px;
  }

  .ij-hero--split .ij-hero__content,
  .ij-hero--split:not(.ij-hero--no-image) .ij-hero__content {
    align-self: center;
    background: none;
    color: var(--color-foreground);
    padding: 0;
    max-width: 560px;
  }

  @media screen and (min-width: 990px) {
    .ij-hero--split .ij-hero__inner {
      grid-template-columns: 5fr 7fr;
    }

    .ij-hero--split .ij-hero__media {
      order: 2;
    }
  }

  /* Full screen: photo fills the first screen edge to edge; the transparent header sits on top of it. */
  .ij-hero--fullscreen .ij-hero__inner {
    min-height: 100svh;
    margin: 0;
    border-radius: 0;
  }

  .ij-hero--fullscreen .ij-hero__media::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 220px;
    background: linear-gradient(to bottom, rgb(0 0 0 / 0.45), rgb(0 0 0 / 0));
    z-index: 1;
    pointer-events: none;
  }

  .ij-hero--fullscreen .ij-hero__media {
    position: relative;
  }

  .ij-hero--fullscreen:not(.ij-hero--no-image) .ij-hero__content {
    padding: clamp(24px, 5vw, 64px) max(var(--page-margin, 16px), calc((100vw - var(--page-width, 1400px)) / 2 + var(--page-margin, 16px))) clamp(40px, 8vh, 96px);
  }

  .ij-hero--fullscreen .ij-hero__buttons .button-secondary {
    color: #fff;
    background: transparent;
    border: 1px solid rgb(255 255 255 / 0.85);
  }

  .ij-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "iamjulia hero",
  "tag": "section",
  "class": "ij-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image focus",
      "options": [
        { "value": "object-position: center center;", "label": "Center" },
        { "value": "object-position: center top;", "label": "Top" },
        { "value": "object-position: center bottom;", "label": "Bottom" }
      ],
      "default": "object-position: center center;"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "split", "label": "Text beside image" },
        { "value": "overlay", "label": "Text over image" },
        { "value": "fullscreen", "label": "Full screen, under the header" }
      ],
      "default": "split"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height (text over image)",
      "options": [
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Text shadow strength",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Personalized party decorations"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A whole birthday, beautifully matched"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Banner, hanging decorations and table garland in one coordinated palette — personalized with your child's name.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop party sets"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "Second button label"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "Second button link"
    }
  ],
  "presets": [
    {
      "name": "iamjulia hero"
    }
  ]
}
{% endschema %}
