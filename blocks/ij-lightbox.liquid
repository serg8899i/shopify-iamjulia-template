{%- comment -%}
  Opens product gallery photos in a modal viewer (dimmed page, photo fitted to the screen, close and arrows).
  Use with the media gallery's own zoom turned off.
{%- endcomment -%}

<script src="{{ 'ij-lightbox.js' | asset_url }}" type="module"></script>

<ij-lightbox class="ij-lightbox" {{ block.shopify_attributes }}>
  <dialog
    class="ij-lightbox__dialog"
    aria-label="{{ closest.product.title | escape }}"
    style="--ij-lightbox-overlay: {{ block.settings.overlay_color }};"
  >
    <div class="ij-lightbox__stage">
      <img class="ij-lightbox__image" alt="" width="1600" height="1200">
    </div>
    <button type="button" class="ij-lightbox__button ij-lightbox__close" aria-label="{{ 'actions.close' | t }}">
      {{ 'icon-close.svg' | inline_asset_content }}
    </button>
    <button
      type="button"
      class="ij-lightbox__button ij-lightbox__prev"
      aria-label="{{ 'content.pagination.previous' | t }}"
    >
      {{ 'icon-chevron-left.svg' | inline_asset_content }}
    </button>
    <button
      type="button"
      class="ij-lightbox__button ij-lightbox__next"
      aria-label="{{ 'content.pagination.next' | t }}"
    >
      {{ 'icon-chevron-right.svg' | inline_asset_content }}
    </button>
    <p class="ij-lightbox__counter" aria-live="polite"></p>
  </dialog>
</ij-lightbox>

{% stylesheet %}
  media-gallery .product-media-container--image {
    cursor: zoom-in;
  }

  .ij-lightbox {
    display: contents;
  }

  .ij-lightbox__dialog {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
    overflow: hidden;
  }

  .ij-lightbox__dialog::backdrop {
    background: var(--ij-lightbox-overlay, rgb(42 36 31 / 0.88));
  }

  .ij-lightbox__dialog[open] {
    display: block;
  }

  .ij-lightbox__stage {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 64px 88px 56px;
    box-sizing: border-box;
  }

  .ij-lightbox__image {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 12px;
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.35);
    background: rgb(255 255 255 / 0.06);
  }

  .ij-lightbox__button {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #fffbf5;
    color: #3a322b;
    cursor: pointer;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.2);
  }

  .ij-lightbox__button svg {
    width: 18px;
    height: 18px;
  }

  .ij-lightbox__button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .ij-lightbox__close {
    top: 16px;
    right: 16px;
  }

  .ij-lightbox__prev,
  .ij-lightbox__next {
    top: 50%;
    transform: translateY(-50%);
  }

  .ij-lightbox__prev {
    left: 20px;
  }

  .ij-lightbox__next {
    right: 20px;
  }

  .ij-lightbox__counter {
    position: absolute;
    bottom: 16px;
    left: 0;
    right: 0;
    margin: 0;
    text-align: center;
    pointer-events: none;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
  }

  .ij-lightbox[data-single] :is(.ij-lightbox__prev, .ij-lightbox__next, .ij-lightbox__counter) {
    display: none;
  }

  html.ij-lightbox-open {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ij-lightbox__dialog[open],
    .ij-lightbox__dialog[open]::backdrop {
      animation: ij-lightbox-fade 0.2s ease-out;
    }
  }

  @keyframes ij-lightbox-fade {
    from {
      opacity: 0;
    }
  }

  @media screen and (max-width: 749px) {
    .ij-lightbox__stage {
      padding: 72px 12px 64px;
    }

    .ij-lightbox__prev,
    .ij-lightbox__next {
      top: auto;
      bottom: 8px;
      transform: none;
      width: 44px;
      height: 44px;
    }

    .ij-lightbox__prev {
      left: 16px;
    }

    .ij-lightbox__next {
      right: 16px;
    }

    .ij-lightbox__counter {
      bottom: 22px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Photo viewer",
  "settings": [
    {
      "type": "paragraph",
      "content": "Opens gallery photos in a viewer. Turn off Zoom in the media gallery settings."
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Background",
      "alpha": true,
      "default": "rgba(42, 36, 31, 0.88)"
    }
  ],
  "presets": [
    {
      "name": "Photo viewer"
    }
  ]
}
{% endschema %}
